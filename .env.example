# AI Affiliate OS — Environment Variables
# Copy to .env.local and fill in your credentials.

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── AI Provider ─────────────────────────────────────────────
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4

# ─── n8n ─────────────────────────────────────────────────────
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# ─── YouTube ─────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ─── TikTok ──────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=

# ─── Instagram ───────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ─── Telegram Bot ────────────────────────────────────────────
# Create bot via @BotFather, get token, then:
# GET http://localhost:3000/api/telegram to set webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── WhatsApp Bot ────────────────────────────────────────────
# Create app at developers.facebook.com, get tokens, then:
# Set webhook URL to: <YOUR_APP>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ai-affiliate-os-verify
